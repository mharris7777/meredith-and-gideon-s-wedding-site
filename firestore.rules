rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // All reads and writes go through the function. Guests never read raw answers.
    match /crosswordAttempts/{document=**} { allow read, write: if false; }
    match /crosswordRateLimits/{document=**} { allow read, write: if false; }
  }
}
